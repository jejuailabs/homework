rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function upload(uploadId) {
      // The Firebase Storage service agent needs its Firestore rules validation role.
      return firestore.get(/databases/(default)/documents/uploads/$(uploadId)).data;
    }
    function activeUser(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return user.disabled != true && request.auth.token.authVersion == user.authVersion;
    }
    function exhibitionUpload(uploadId) {
      return firestore.get(/databases/(default)/documents/exhibitionUploads/$(uploadId)).data;
    }
    function activeExhibitionUser(uid, uploadId) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return user.get('disabled', false) != true
        && (user.role == 'teacher'
          || (user.role == 'student'
            && request.auth.token.authVersion == user.authVersion
            && exhibitionUpload(uploadId).classId == user.classId
            && exhibitionUpload(uploadId).studentId == user.studentId));
    }
    match /exhibition-uploads/{uid}/{uploadId}/original {
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == uid
        && activeExhibitionUser(uid, uploadId)
        && exhibitionUpload(uploadId).userUid == uid
        && exhibitionUpload(uploadId).path == 'exhibition-uploads/' + uid + '/' + uploadId + '/original'
        && exhibitionUpload(uploadId).status == 'pending'
        && request.time < exhibitionUpload(uploadId).expiresAt
        && request.resource.size == exhibitionUpload(uploadId).size
        && request.resource.contentType == exhibitionUpload(uploadId).contentType
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read, update, delete: if false;
    }
    match /uploads/{uid}/{uploadId}/file {
      // Only creation is allowed. Completed files cannot be overwritten or deleted by a client.
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == uid
        && activeUser(uid)
        && upload(uploadId).userUid == uid
        && upload(uploadId).status == 'pending'
        && request.time < upload(uploadId).expiresAt
        && request.resource.size == upload(uploadId).size
        && request.resource.contentType == upload(uploadId).contentType
        && request.resource.size > 0
        && ((request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
              || request.resource.contentType == 'application/pdf')
              && request.resource.size <= 100 * 1024 * 1024
            || request.resource.contentType.matches('video/(mp4|webm|quicktime)')
              && request.resource.size <= 250 * 1024 * 1024);
      allow read, update, delete: if false;
    }
    match /assignment-materials/{uid}/{uploadId}/file {
      function material() {return firestore.get(/databases/(default)/documents/assignmentMaterials/$(uploadId)).data;}
      function teacher() {return firestore.get(/databases/(default)/documents/users/$(uid)).data;}
      allow create: if request.auth != null && request.auth.uid == uid && resource == null
        && teacher().role == 'teacher' && teacher().get('disabled', false) != true
        && material().userUid == uid && material().status == 'pending'
        && material().path == 'assignment-materials/' + uid + '/' + uploadId + '/file'
        && request.time < material().expiresAt && request.resource.size == material().size
        && request.resource.contentType == material().contentType && request.resource.size > 0
        && ((request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 25 * 1024 * 1024)
          || (request.resource.contentType.matches('video/(mp4|webm|quicktime)') && request.resource.size <= 250 * 1024 * 1024));
      allow read, update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
