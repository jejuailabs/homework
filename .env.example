NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local server only. Never commit the credential file.
GOOGLE_APPLICATION_CREDENTIALS=
# On Vercel, use a server-only environment variable instead of a local path.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional stable 32-byte base64 key for teacher-only code lookup.
# If blank, a separate encryption key is derived from the server's service-account private key.
STUDENT_CODE_ENCRYPTION_KEY=
# Server-only AI. Never prefix these variables with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Independent artwork modules. Turning a module off preserves saved data.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Comma-separated artwork modules to disable: voice, guestbook, artbook.
ARTWORK_MODULES_DISABLED=
# Disable the student room, pet growth and private journal without deleting data.
MY_SPACE_DISABLED=false
# Optional stable secret for signed anonymous guestbook sessions; defaults to a key derived from the service-account private key.
CREATIVE_VISITOR_SECRET=
# Separate voice storage budget per teacher (default 100 MiB); recordings are limited to 60 seconds.
VOICE_STORAGE_LIMIT_BYTES=104857600
# Optional request caps (attempts, not token or monetary budgets).
AI_TEACHER_MINUTE_LIMIT=4
AI_TEACHER_DAILY_LIMIT=40
AI_GLOBAL_DAILY_LIMIT=400
# Per-teacher exhibition storage budget, including original photos and derivatives (default 5 GiB).
EXHIBITION_STORAGE_LIMIT_BYTES=5368709120
# Comma-separated tool IDs to hide for all teachers; saved work is retained.
TOOLS_DISABLED=
# Server-only random secret (16+ characters, no whitespace/newlines) for scheduled daily-quiz preparation.
CRON_SECRET=
# Optional server-only approved Overpass endpoint. Default: https://overpass.private.coffee/api/interpreter
NEIGHBORHOOD_OVERPASS_URL=
