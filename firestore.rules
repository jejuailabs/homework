rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the pre-existing book application in this shared Firebase project.
    match /bookData/{docId} { allow read, write: if request.auth != null; }
    match /classCanvases/{canvasId} {
      function canvas() { return get(/databases/$(database)/documents/classCanvases/$(canvasId)).data; }
      function permitted(value) {
        let grant = get(/databases/$(database)/documents/classCanvases/$(canvasId)/readerGrants/$(request.auth.uid)).data;
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return request.auth != null && user.get('disabled',false) != true && grant.expiresAt > request.time
          && ((grant.role == 'teacher' && value.ownerUid == request.auth.uid)
            || (grant.role == 'student' && user.role == 'student' && user.classId == value.classId
              && value.status != 'archived' && grant.authVersion == user.authVersion
              && request.auth.token.authVersion == user.authVersion
              && (value.studentIds.size() == 0 || user.studentId in value.studentIds)
              && get(/databases/$(database)/documents/classes/$(user.classId)/students/$(user.studentId)).data.authUid == request.auth.uid
              && get(/databases/$(database)/documents/classes/$(user.classId)/students/$(user.studentId)).data.get('disabled',false) != true));
      }
      allow get: if request.auth != null && permitted(resource.data);
      allow list, write: if false;
      match /canvasRevisions/{epoch} {
        allow get: if request.auth != null && permitted(canvas()) && canvas().epoch == epoch;
        allow list, write: if false;
        match /canvasChannels/{channel} {
          allow read: if request.auth != null && permitted(canvas()) && canvas().epoch == epoch;
          allow write: if false;
        }
      }
      match /canvasPresence/{person} {
        allow read: if request.auth != null && permitted(canvas());
        allow write: if false;
      }
    }
    match /playRooms/{roomId} {
      function room() { return get(/databases/$(database)/documents/playRooms/$(roomId)).data; }
      function grant() { return get(/databases/$(database)/documents/playRooms/$(roomId)/readerGrants/$(request.auth.uid)).data; }
      function permitted(value) {
        let permission = grant();
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return request.auth != null && user.get('disabled',false) != true
          && value.status != 'closed' && permission.expiresAt > request.time
          && ((permission.role == 'teacher' && value.ownerUid == request.auth.uid)
            || (permission.role == 'student' && user.role == 'student'
              && user.classId == value.classId && permission.classId == value.classId
              && permission.playerKey == user.studentId && user.studentId in value.playerKeys
              && permission.authVersion == user.authVersion && request.auth.token.authVersion == user.authVersion
              && get(/databases/$(database)/documents/classes/$(user.classId)/settings/playground).data.enabled == true
              && get(/databases/$(database)/documents/classes/$(user.classId)/students/$(user.studentId)).data.authUid == request.auth.uid
              && get(/databases/$(database)/documents/classes/$(user.classId)/students/$(user.studentId)).data.get('disabled',false) != true));
      }
      allow get: if request.auth != null && permitted(resource.data);
      allow list, write: if false;
      match /rounds/{round} { allow get: if request.auth != null && permitted(room()); allow list, write: if false; }
      match /players/{key} {
        allow get: if request.auth != null && permitted(room()) && (key == grant().playerKey || grant().role == 'teacher');
        allow list: if request.auth != null && permitted(room()) && grant().role == 'teacher';
        allow write: if false;
      }
      match /secrets/{secret} { allow read, write: if false; }
      match /answers/{answer} { allow read, write: if false; }
      match /readerGrants/{uid} { allow read, write: if false; }
      match /settlements/{settlement} { allow read, write: if false; }
    }
    // All application access goes through authenticated, authorized server APIs.
    // Admin SDK bypasses these rules: server ownership checks remain mandatory.
    match /{document=**} { allow read, write: if false; }
  }
}
